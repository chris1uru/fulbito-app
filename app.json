{
  "expo": {
    "name": "Fulbito",
    "slug": "fulbito-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "fulbito",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fulbito.app"
    },
    "android": {
      "package": "com.fulbito.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Fulbito necesita acceder a tus fotos para publicar imágenes de complejos y canchas.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font"
    ]
  }
}
